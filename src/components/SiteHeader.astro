---
import HeaderTools from './HeaderTools.tsx';
export interface Props { path: string; }
const { path } = Astro.props;
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/process', label: 'The build' },
  { href: '/setup', label: 'Setup' },
  { href: '/downloads', label: 'Downloads' },
  { href: '/about', label: 'About' },
];
const current = (href: string) => (path === href ? 'page' : undefined);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" translate="no" aria-label="MAK SYNTH home">MAK&nbsp;SYNTH</a>
    <nav class="nav-primary" aria-label="Main">
      <ul class="nav-list">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <HeaderTools client:load />
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Main, small screens" hidden>
    <ul>
      <li><a href="/" aria-current={current('/')}>Home</a></li>
      {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>
