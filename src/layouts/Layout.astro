---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

export interface Props {
  /** Page name; the document title becomes "MAK SYNTH - <title>" (home uses its own). */
  pageTitle: string;
  description: string;
  /** Clean path without a trailing slash, e.g. "/about" ("/" for home). */
  path: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Full document title override (used by the home page). */
  fullTitle?: string;
  /** Optional class on <body>, for page-level styling. */
  bodyClass?: string;
}
const { pageTitle, description, path, ogType = 'website', noindex = false, jsonLd, fullTitle, bodyClass } = Astro.props;
const site = 'https://maksynth.com';
const canonical = path === '/' ? site + '/' : site + path;
const docTitle = fullTitle ?? `MAK SYNTH - ${pageTitle}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Sanitize build-time JSON-LD for embedding: escape characters that could close the
// script element or start markup.
const sanitizeJsonLd = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" />

    <meta property="og:site_name" content="MAK SYNTH" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + '/img/og-image.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The white MAK SYNTH controller beside the MAK SYNTH wordmark." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={docTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site + '/img/og-image.jpg'} />
    <meta name="twitter:image:alt" content="The white MAK SYNTH controller beside the MAK SYNTH wordmark." />

    <link rel="preload" href="/fonts/synthek.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <script is:inline>
      /* Runs before first paint and applies saved display preferences, so the page
         never flashes the wrong theme. Dark is the default theme. */
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        try {
          var theme = localStorage.getItem('mak-theme');
          r.dataset.theme = theme === 'light' ? 'light' : 'dark';
          var contrast = localStorage.getItem('mak-contrast');
          if (contrast === 'high' || contrast === 'normal') r.dataset.contrast = contrast;
          if (localStorage.getItem('mak-motion') === 'reduce') r.dataset.motion = 'reduce';
          var text = localStorage.getItem('mak-text');
          if (text === '1' || text === '2' || text === '3') r.dataset.text = text;
        } catch (e) {
          r.dataset.theme = 'dark';
        }
        // Browser interface color matches the site theme, not only the device setting.
        var color = r.dataset.theme === 'light' ? '#ffffff' : '#0d0d0d';
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', color);
      })();
    </script>
    {ld.map((item) => <script type="application/ld+json" set:html={sanitizeJsonLd(item)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader path={path} />
    <main id="main" tabindex="-1">
      <div class="container print-head" aria-hidden="true"><span translate="no">MAK SYNTH</span>, {canonical}</div>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
