---
import Layout from '../layouts/Layout.astro';
---
<Layout pageTitle="Page not found" description="There’s no page at this address on the MAK SYNTH site." path="/404" noindex>
  <section class="section error-page">
    <div class="container"><div class="measure">
      <h1>Page not found</h1>
      <p class="lead">There’s no page at this address, so there’s nothing to play here. It may have moved, or the link may have a typo.</p>
      <div class="btn-row">
        <a class="btn" href="/">Go to the home page</a>
        <a class="btn btn--secondary" href="/setup">Open the setup guide</a>
      </div>
      <nav aria-label="Pages on this site" class="error-links">
        <h2 class="h-small">Other pages</h2>
        <ul>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/process">The build</a></li>
          <li><a href="/downloads">Downloads</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/accessibility">Accessibility settings</a></li>
        </ul>
      </nav>
    </div></div>
  </section>
</Layout>
