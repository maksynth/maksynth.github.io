---
import Layout from '../layouts/Layout.astro';
import AccessibilitySettings from '../components/AccessibilitySettings.tsx';
import Motion from '../components/Motion.astro';
---
<Layout
  pageTitle="Accessibility"
  description="Display settings for MAK SYNTH (theme, text size, high contrast and reduced motion) and the site’s accessibility statement."
  path="/accessibility"
>
  <section class="page-head">
    <div class="container">
      <h1>Accessibility</h1>
      <p class="lead">Adjust how the site looks and moves. Your device settings apply on their own, and these choices are remembered in this browser.</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="settings-title">
    <div class="container"><div class="measure">
      <h2 id="settings-title" class="sr-only">Display settings</h2>
      <noscript><p class="noscript-note">These settings need JavaScript. Your device’s own theme, contrast and motion settings still apply, and browser zoom works on every page.</p></noscript>
      <AccessibilitySettings client:load />
    </div></div>
  </section>

  <section class="section section--surface" aria-labelledby="statement-title">
    <div class="container"><div class="measure prose">
      <h2 id="statement-title">Accessibility statement</h2>
      <p>MAK SYNTH aims to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA.</p>
      <h3>What the site supports</h3>
      <ul>
        <li>Every page works with a keyboard, including the playable synth on the home page.</li>
        <li>Images have text descriptions, and the synth’s graphs describe what they show.</li>
        <li>Animations follow your device’s reduced motion setting or the switch above, and the moving background on the home page has a pause button.</li>
        <li>Text can be enlarged here or with browser zoom up to 400% without losing content.</li>
        <li>Pages keep their content and navigation when JavaScript doesn’t load. The playable synth and these settings are the exceptions.</li>
      </ul>
      <h3>Known limitations</h3>
      <p>The playable synth is about sound. Everything it teaches is also written out on the How it works page, including what each control does and its range.</p>
      <p class="muted">Last reviewed November 2026.</p>
    </div></div>
  </section>
  <Motion />
</Layout>
