---
import Layout from '../layouts/Layout.astro';
---
<Layout pageTitle="Something went wrong" description="The MAK SYNTH site had a problem loading this page." path="/500" noindex>
  <section class="section error-page">
    <div class="container"><div class="measure">
      <h1>Something went wrong</h1>
      <p class="lead">This page couldn’t load because of a problem on our side. Try again in a moment, or go to the home page.</p>
      <div class="btn-row">
        <a class="btn" href="/">Go to the home page</a>
        <a class="btn btn--secondary" href="/downloads">Go to the downloads</a>
      </div>
    </div></div>
  </section>
</Layout>
