---
import Layout from '../layouts/Layout.astro';
import Motion from '../components/Motion.astro';
import ControlExplorer from '../components/ControlExplorer.tsx';
import WaveCards from '../components/WaveCards.tsx';
import PathCards from '../components/PathCards.tsx';


---
<Layout
  pageTitle="How it works"
  description="How MAK SYNTH turns a key press into sound: the Arduino controller, serial messages, the SuperCollider engine, and the six controls."
  path="/how-it-works"
>
  <section class="page-head">
    <div class="container">
      <h1>How does MAK SYNTH work?</h1>
      <p class="lead">A controller you build connects to a sound engine on your computer, all talking over a USB cable to get the sound you hear.</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="path-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="path-title">The steps behind what you see & hear</h2>
      </div>
      <PathCards client:visible />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="controls-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="controls-title">The six controls & what they do</h2>
        <p>Every knob maps to one idea from synthesis that you’ll find on almost any synthesizer. Open one to turn it and see what the engine does with it.</p>
      </div>
      <ControlExplorer client:visible />
    </div>
  </section>

  <section class="section" aria-labelledby="waves-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="waves-title">The five waveforms included</h2>
        <p>The waveform is the raw tone a voice begins with, before the filter and envelope shape it.</p>
      </div>
      <WaveCards client:visible />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="learn-title">
    <div class="container split">
      <div class="prose" data-reveal>
        <h2 id="learn-title">The learning process</h2>
        <p>Each control changes the sound the moment you move it, and the visualizers react at the same time, so the link between what you do and what you hear is easy to follow.</p>
        <p>Oscillators, envelopes, filters, and signal flow work the same way on almost every synthesizer, either hardware or software. Everything you’ll learn can be applied to whatever you do next!</p>
        <div class="btn-row">
          <a class="btn" href="/setup">Set up your synth</a>
          <a class="btn btn--secondary" href="/process">See how it was built</a>
        </div>
      </div>
      <figure class="split__media" data-reveal>
        <img src="/img/ui-closeup-800.webp" srcset="/img/ui-closeup-480.webp 480w, /img/ui-closeup-800.webp 800w, /img/ui-closeup-953.webp 953w" sizes="(min-width: 56rem) 34rem, 92vw" width="800" height="596" loading="lazy" decoding="async" alt="A CAD render of an early control panel with knob groups for envelopes, pitch, filter and modulation, and a small screen." />
      </figure>
    </div>
  </section>
  <Motion />
</Layout>
