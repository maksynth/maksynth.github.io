---
import Layout from '../layouts/Layout.astro';
import HeroWave from '../components/HeroWave.tsx';
import FeatureScene from '../components/FeatureScene.astro';
import PlaySynth from '../components/PlaySynth.tsx';
import SpecBento from '../components/SpecBento.tsx';
import Motion from '../components/Motion.astro';
import { FontAwesomeIcon } from '../lib/fa';
import { faChevronDown, faDownload } from '@fortawesome/free-solid-svg-icons';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'MAK SYNTH', url: 'https://maksynth.com/' },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'MAK SYNTH', url: 'https://maksynth.com/' },
];
---
<Layout
  pageTitle="Home"
  fullTitle="MAK SYNTH - A synthesizer kit you build yourself"
  description="A synthesizer kit for learning sound synthesis and electronics: twelve keys and six knobs on an Arduino board, with the sound made in SuperCollider."
  path="/"
  jsonLd={jsonLd}
  bodyClass="page-home"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/hero-wave-dark-960.webp" media="(max-width: 59.99rem)" fetchpriority="high" />
    <link rel="preload" as="image" href="/img/hero-wave-dark.webp" media="(min-width: 60rem)" fetchpriority="high" />
    <link rel="preload" as="image" href="/img/hero-synth-1040.webp" imagesrcset="/img/hero-synth-720.webp 720w, /img/hero-synth-1040.webp 1040w, /img/hero-synth-1302.webp 1302w" imagesizes="(min-width: 48rem) 44rem, 92vw" fetchpriority="high" />
  </Fragment>

  <section class="hero hero--center" aria-labelledby="hero-title">
    <HeroWave client:load />
    <div class="hero-scrim"></div>
    <div class="container hero-center">
      <h1 class="hero-wordmark" id="hero-title" translate="no">MAK SYNTH</h1>
      <p class="hero-lead">A hands-on synthesizer kit for learning sound design. Built to teach the engineering behind electronic music.</p>
      <a class="btn btn--small hero-cta" href="/setup">Set up your synth</a>
      <figure class="hero-figure">
        <img
          src="/img/hero-synth-1040.webp"
          srcset="/img/hero-synth-720.webp 720w, /img/hero-synth-1040.webp 1040w, /img/hero-synth-1302.webp 1302w"
          sizes="(min-width: 48rem) 44rem, 92vw"
          width="1040" height="801"
          alt="The white MAK SYNTH controller, with knobs labeled attack, decay, sustain, release, cutoff and resonance above a twelve-key keyboard."
          fetchpriority="high"
        />
      </figure>
    </div>
    <a class="scroll-cue" href="#overview" aria-label="Scroll to the overview">
      <FontAwesomeIcon icon={faChevronDown} />
    </a>
  </section>

  <FeatureScene />

  <section class="section section--surface play-section" id="play" aria-labelledby="play-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="play-title">Try out a sample version!</h2>
        <p>This is a browser version of the MAK SYNTH sound engine, with the same five waveforms, four octaves, and six knobs. Sound starts when you play a key, so make sure that you check your volume first.</p>
      </div>
      <noscript><p class="noscript-note">The playable synth needs JavaScript. Everything it shows is also explained on the How it works page.</p></noscript>
      <PlaySynth client:visible />
    </div>
  </section>

  <section class="section" aria-labelledby="specs-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="specs-title">At a glance</h2>
      </div>
      <SpecBento client:visible />
    </div>
  </section>

  <section class="section section--surface cta-band" aria-labelledby="cta-title">
    <div class="container" data-reveal>
      <h2 id="cta-title">Ready to set it up?</h2>
      <p>Setup takes about 20 to 30 minutes the first time, mostly installing and configuring the software. Interested in the design process behind it? Check out our page on <a href="/process">how the synth was designed and built!</a>.</p>
      <div class="btn-row">
        <a class="btn" href="/setup">Open the setup guide</a>
        <a class="btn btn--secondary" href="/downloads"><FontAwesomeIcon icon={faDownload} />Go to the downloads</a>
      </div>
    </div>
  </section>

  <Motion />
  <script>
    import '../scripts/smooth';
  </script>
</Layout>
