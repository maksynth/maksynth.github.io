---
import Layout from '../layouts/Layout.astro';
import Motion from '../components/Motion.astro';
import { FontAwesomeIcon } from '../lib/fa';
import { faDownload, faMicrochip, faWaveSquare, faChevronRight, faArrowUpRightFromSquare, faCode, faLaptopCode } from '@fortawesome/free-solid-svg-icons';
import inoSource from '../../public/assets/downloadables/synthFiles/synthFile/synthFile.ino?raw';
import scdSource from '../../public/assets/downloadables/synthFiles/synthFile.scd?raw';

const ZIP = '/assets/downloadables/synthFiles.zip';
const files = [
  {
    icon: faMicrochip, title: 'Controller firmware', file: 'synthFile/synthFile.ino',
    text: 'The Arduino firmware for the controller. It reads the twelve keys and six knobs and sends them to the sound engine over USB.',
    meta: [['Type', 'Arduino sketch'], ['Opens in', 'Arduino IDE']],
    source: inoSource,
  },
  {
    icon: faWaveSquare, title: 'Sound engine', file: 'synthFile.scd',
    text: 'The SuperCollider patch that turns your playing into sound. It builds the voices, filter and envelope, draws the visualizers, and finds the controller on its own.',
    meta: [['Type', 'SuperCollider file'], ['Needs', 'SuperCollider 3.14 or newer'], ['Runs on', 'Windows and macOS']],
    source: scdSource,
  },
];
const software = [
  { icon: faCode, name: 'Arduino IDE', href: 'https://www.arduino.cc/en/software', text: 'Flashes synthFile.ino onto the controller.', link: 'Get the Arduino IDE' },
  { icon: faLaptopCode, name: 'SuperCollider', href: 'https://supercollider.github.io/', text: 'Runs synthFile.scd and makes the sound.', link: 'Get SuperCollider' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'MAK SYNTH sound engine',
    applicationCategory: 'MultimediaApplication', operatingSystem: 'Windows, macOS', isAccessibleForFree: true,
    downloadUrl: 'https://maksynth.com/assets/downloadables/synthFiles.zip',
  },
];
---
<Layout
  pageTitle="Downloads"
  description="Download the free files that run MAK SYNTH in one ZIP: the Arduino controller firmware (synthFile.ino) and the SuperCollider sound engine (synthFile.scd)."
  path="/downloads"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="container">
      <h1>Downloads</h1>
      <p class="lead">Download the ZIP with the two files that run MAK SYNTH. Once the ZIP is downloaded, visit the <a href="/setup">setup guide</a> to walk through the installation process.</p>
      <div class="btn-row page-head__actions">
        <a class="btn" href={ZIP} download><FontAwesomeIcon icon={faDownload} />Download the synth files (ZIP)</a>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label="What’s in the ZIP">
    <div class="container">
      <h2 class="sr-only">What’s in the ZIP</h2>
      <ul class="card-grid card-grid--2" data-reveal="stagger">
        {files.map((f) => (
          <li>
            <article class="card dl-card">
              <span class="card__icon" aria-hidden="true"><FontAwesomeIcon icon={f.icon} /></span>
              <h3 class="card__title">{f.title}</h3>
              <span class="file-name" translate="no">{f.file}</span>
              <p>{f.text}</p>
              <dl class="dl-meta">
                {f.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
              </dl>
              <details class="code-preview">
                <summary><FontAwesomeIcon icon={faChevronRight} />Preview the code</summary>
                <pre tabindex="0" aria-label={`Source code of ${f.file}`}><code translate="no">{f.source}</code></pre>
              </details>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="software-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="software-title">Software you need</h2>
        <p>Both are free and run on Windows and macOS. Install them before you open the files above.</p>
      </div>
      <ul class="card-grid card-grid--2" data-reveal="stagger">
        {software.map((s) => (
          <li>
            <article class="card card--link">
              <span class="card__icon" aria-hidden="true"><FontAwesomeIcon icon={s.icon} /></span>
              <h3 translate="no">{s.name}</h3>
              <p>{s.text}</p>
              <div class="card__actions">
                <a class="card__link" href={s.href} target="_blank" rel="noopener noreferrer">{s.link}<FontAwesomeIcon icon={faArrowUpRightFromSquare} className="ext-icon" /><span class="sr-only"> (opens in a new tab)</span></a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="dl-next-title">
    <div class="container" data-reveal>
      <h2 id="dl-next-title">Next step, setup!</h2>
      <p>The setup guide covers flashing the controller and starting the engine, with a checklist that remembers where you left off.</p>
      <div class="btn-row"><a class="btn" href="/setup">Open the setup guide</a></div>
    </div>
  </section>
  <Motion />
</Layout>
