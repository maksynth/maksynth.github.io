{
  "schemaVersion": 1,
  "appType": "creative",
  "platforms": [
    "web"
  ],
  "tags": [
    "Web",
    "Public"
  ],
  "sensitiveData": false,
  "frontend": "Astro",
  "host": "GitHub Pages",
  "backend": "none",
  "iconSet": "font-awesome-free",
  "regions": [],
  "legalDetails": "declined",
  "brand": {
    "accentColor": "user-chosen",
    "logo": "text",
    "favicon": "provided",
    "defaultTheme": "dark"
  },
  "exceptions": [
    {
      "rule": "gradient",
      "paths": [
        "src/components/reactbits/GradientWaves.tsx",
        "src/components/HeroWave.tsx"
      ],
      "reason": "User asked for a full moving gradient wave behind the home page, even though it goes against the standards",
      "date": "2026-11-23"
    },
    {
      "rule": "icon-set",
      "paths": [
        "src/components/HeaderTools.tsx"
      ],
      "value": "Lucide Sun and Moon for the theme toggle",
      "reason": "User asked for a more line-like sun icon; Font Awesome Free has no line-style sun",
      "date": "2026-11-23"
    }
  ]
}
